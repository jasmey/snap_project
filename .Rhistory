stacked_bar <- function(n_tot, n_ven, n_jup, n_air, n_unexp) {
df <- data.frame(
category = factor(
c("Venus", "Jupiter", "Aircraft", "Unexplained"),
levels = c("Unexplained", "Aircraft", "Jupiter", "Venus")
),
count = c(n_ven, n_jup, n_air, n_unexp)
)
colors <- c(
"Venus"       = "orange",
"Jupiter"     = "red",
"Aircraft"    = "skyblue",
"Unexplained" = "darkgreen"
)
text_colors <- c(
"Venus"       = "#7a4400",
"Jupiter"     = "#3a1200",
"Aircraft"    = "#0a3a52",
"Unexplained" = "#003300"
)
# Compute cumulative midpoints for centered labels, only for non-zero segments
df <- df |>
mutate(
ymax = cumsum(count),
ymin = lag(ymax, default = 0),
ymid = (ymin + ymax) / 2
) |>
filter(count > 0)
ggplot(df, aes(x = "", y = count, fill = category)) +
geom_col(width = 0.65, color = NA) +
geom_text(
data = ~ filter(.x, !(category == "Unexplained" & n_ven > 0 & n_jup > 0 & n_air > 0)),
aes(y = ymid, label = category),
color = "black",
size = 6,
fontface = "bold",
family = "orbitron"
) +
scale_fill_manual(values = colors, guide = "none") +
scale_y_continuous(
expand  = c(0, 0)
) +
coord_cartesian(ylim = c(-60, n_tot + 50)) +
labs(x = NULL, y = NULL) +
theme_minimal() +
ufo_theme
}
map = ggplot(ufo_dates, aes(x = month, y = cumulative)) +
geom_area(fill = "#39ff1422", color = NA) +
geom_line(color = "darkgreen", linewidth = 1.2) +
scale_x_date(date_breaks = "6 months", date_labels = "%b '%y") +
scale_y_continuous(labels = scales::comma) +
labs(x = NULL, y = "Cumulative sightings") +
theme_minimal() +
theme(
plot.background  = element_rect(fill = "black", color = NA),
panel.background = element_rect(fill = "black", color = NA),
panel.grid.major = element_line(color = "#ffffff18"),
panel.grid.minor = element_blank(),
axis.text  = element_text(color = "#aaaaaa", size = 10),
axis.title = element_text(color = "#aaaaaa", size = 11),
plot.margin = margin(8, 8, 8, 8)
)
bar_plot = stacked_bar(n_total, 0, 0, 0, n_total) +
theme(
plot.background  = element_rect(fill = "black", color = NA),
panel.background = element_rect(fill = "black", color = NA),
panel.grid       = element_blank(),
axis.text        = element_blank(),
axis.ticks       = element_blank(),
plot.margin      = margin(4, 4, 4, 4)
)
final = map + bar_plot + plot_layout(widths = c(4, 1))
final
map = ggplot() +
geom_polygon(
data = us_map,
aes(x = long, y = lat, group = group),
fill = "white",
color = "black"
) +
geom_point(
data = ufo_data_no_port,
aes(x = lng, y = lat),
label = "👽",
color = "darkgreen",
size = 2
) +
coord_fixed(1.3) +
scale_x_continuous(expand = c(0, 0)) +
scale_y_continuous(expand = c(0, 0)) +
ufo_theme
bar_plot = stacked_bar(n_total, n_venus, n_jupiter, n_airport, n_total - n_venus - n_jupiter - n_airport) + coord_cartesian(ylim = c(-400, 1500))
final = map + bar_plot + plot_layout(widths = c(4, .75)) +
plot_annotation(theme = theme(plot.background = element_rect(fill = "transparent", color = NA)))
final
